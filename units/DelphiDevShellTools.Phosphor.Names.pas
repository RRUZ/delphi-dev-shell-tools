function GetPhosphorIconName(ACode: Word): string;
begin
  var LLow := Low(cIconNames);
  var LHigh := High(cIconNames);
  while LLow <= LHigh do
  begin
    var LMiddle := (LLow + LHigh) div 2;
    if cIconNames[LMiddle].Code = ACode then
      Exit(cIconNames[LMiddle].Name);
    if cIconNames[LMiddle].Code < ACode then
      LLow := LMiddle + 1
    else
      LHigh := LMiddle - 1;
  end;
  Result := '';
end;

end.
